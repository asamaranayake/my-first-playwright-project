{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "moduleResolution": "node",
    "types": ["node", "@playwright/test"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "./dist",
    "rootDir": ".",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@pages/*": ["src/pages/*"],
      "@fixtures/*": ["fixtures/*"],
      "@test-data/*": ["tests/test-data/*"],
      "@reporters/*": ["reporters/*"]
    }
  },
  "include": [
    "playwright.config.ts",
    "src/**/*",
    "tests/**/*",
    "fixtures/**/*"
, "src/pages/auth-demo/InventoryPage.ts"  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
